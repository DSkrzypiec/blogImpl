---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostLink from "../../components/PostLink.astro";

// Only posts that have a Polish version are listed here.
const posts = [
  {
    "title": "Przygoda w start-up'ie",
    "date": "2026-10-25",
    "tags": [],
    "href": "/pl/startup"
  },
  {
    "title": "CLI, którego potrzebujemy",
    "date": "2026-08-18",
    "tags": ["Inżynieria oprogramowania", "Inżynieria danych"],
    "href": "/pl/dst"
  },
  {
    "title": "Warzenie piwa, a inżynieria oprogramowania",
    "date": "2026-06-27",
    "tags": ["Ogólne"],
    "href": "/pl/beer"
  }
];

// A post is a draft when its page passes draft="…" to <Post>.
// Drafts are listed in dev only; deployed builds hide them.
const sources = import.meta.glob<string>("./*.astro", { query: "?raw", import: "default", eager: true });
const isDraft = (href: string) =>
  /<Post[^>]*\sdraft=/.test(sources[href.replace(/^\/pl\//, "./") + ".astro"] ?? "");
const visiblePosts = posts
  .map((post) => ({ ...post, draft: isDraft(post.href) }))
  .filter((post) => import.meta.env.DEV || !post.draft);
---

<BaseLayout altLocaleUrl="/">
  <section class="post-list">
    {visiblePosts.map((post) => (
      <PostLink {...post} />
    ))}
  </section>
</BaseLayout>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    align-items: center; /* Center the posts */
    gap: 1rem; /* Add spacing between posts */
    max-width: 900px;
    margin: 0 auto;
    padding: 1rem;
    width: 100%;
    box-sizing: border-box;
  }

  /* Mobile responsive adjustments */
  @media (max-width: 480px) {
    .post-list {
      padding: 0.5rem;
      gap: 0.75rem;
    }
  }
</style>
